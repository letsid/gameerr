# Copy to .env (Docker Compose) or .env.local (development). Do not commit.

# Time zone, TZ database name
TZ=Europe/Berlin

# IGDB, required. Create a Twitch application at https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam Web API key, optional, for Steam libraries
STEAM_API_KEY=

# Questarr or QuestarrNG, optional, takes PC, Linux and Mac requests.
# Key: QuestarrNG settings, SeerrNG provider access.
QUESTARR_URL=
QUESTARR_API_KEY=

# ROMarrNG, optional, takes every other platform.
# Key: ROMarrNG Settings > General > SeerrNG provider key.
ROMARR_URL=
ROMARR_API_KEY=
